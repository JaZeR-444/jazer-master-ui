{
  "name": "@jazer/styles",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "JaZeR SCSS/Sass design system — a global BEM bundle (CSS cascade layers) built on @jazer/tokens",
  "exports": {
    ".": "./dist/jazer.css",
    "./css": "./dist/jazer.css",
    "./scss/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "sass src/main.scss dist/jazer.css --load-path=../../node_modules --no-source-map --style=expanded",
    "dev": "sass --watch src/main.scss dist/jazer.css --load-path=../../node_modules --no-source-map",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@jazer/tokens": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "sass": "^1.83.0"
  }
}
