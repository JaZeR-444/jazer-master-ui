{
  "name": "@jazer/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "JaZeR design tokens — single source of truth, distributed to web (SCSS/CSS), iOS (Swift) and Flutter (Dart) via Style Dictionary",
  "exports": {
    "./scss/tokens": "./generated/scss/_tokens.scss",
    "./scss/themes": "./generated/scss/_themes.scss",
    "./css": "./generated/css/variables.css"
  },
  "files": [
    "generated"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs && git diff --exit-code -- generated"
  },
  "devDependencies": {
    "style-dictionary": "^4.0.0"
  }
}
