# This repo lives under a OneDrive-synced path on Windows. OneDrive locks files
# during sync, which breaks pnpm's default symlinked node_modules (EBUSY errors).
# Use a flat/hoisted node_modules (no top-level symlinks) for reliability here.
node-linker=hoisted

# Provision the pinned pnpm via the packageManager field without an interactive prompt.
manage-package-manager-versions=true
